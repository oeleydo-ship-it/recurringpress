{
    "name": "RecurringPress Invoice Manager",
    "version": "1.0.0",
    "description": "A powerful recurring invoice management system for businesses.",
    "requirements": {
        "php": "8.3.0",
        "extensions": [
            "pdo",
            "pdo_mysql",
            "mbstring",
            "tokenizer",
            "xml",
            "ctype",
            "json",
            "bcmath",
            "openssl",
            "fileinfo",
            "zip"
        ],
        "permissions": [
            "storage",
            "bootstrap/cache"
        ]
    },
    "database": {
        "required": true,
        "migrations_path": "database/migrations",
        "seeders": ["DatabaseSeeder"]
    },
    "admin": {
        "required": true,
        "default_role": "admin"
    },
    "post_install": {
        "commands": [
            "config:clear",
            "cache:clear",
            "view:clear",
            "route:clear"
        ],
        "redirect": "/login"
    }
}
